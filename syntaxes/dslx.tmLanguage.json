{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DSLX",
  "scopeName": "source.dslx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#builtin-types" },
    { "include": "#numbers" },
    { "include": "#macros" },
    { "include": "#namespaces" },
    { "include": "#builtin-functions" },
    { "include": "#functions" },
    { "include": "#labels" },
    { "include": "#identifiers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.dslx",
      "begin": "//",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.dslx" } },
      "end": "$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dslx",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.dslx" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.dslx" } },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.other.backtick.dslx",
          "begin": "`",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.dslx" } },
          "end": "`",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.dslx" } },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.dslx",
          "match": "'(?:(\\\\(?:[nrt0'\"\\\\]|x[0-9A-Fa-f]{2}))|[^'\\\\\n])'",
          "captures": { "1": { "name": "constant.character.escape.dslx" } }
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.dslx",
          "match": "\\\\(?:[nrt0'\"\\\\]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        { "name": "invalid.illegal.escape.dslx", "match": "\\\\." }
      ]
    },
    "attributes": {
      "name": "meta.attribute.dslx",
      "begin": "(#\\!?\\[)\\s*([A-Za-z_][A-Za-z0-9_!']*)?",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.attribute.dslx" },
        "2": { "name": "entity.other.attribute-name.dslx" }
      },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.definition.attribute.dslx" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#attribute-brackets" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#identifiers" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "attribute-brackets": {
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#attribute-brackets" },
        { "include": "#numbers" },
        { "include": "#identifiers" },
        { "include": "#punctuation" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "begin": "(?<![A-Za-z0-9_!'])fn(?![A-Za-z0-9_!'])",
          "beginCaptures": { "0": { "name": "storage.type.function.dslx" } },
          "end": "([A-Za-z_][A-Za-z0-9_!']*)|(?=[(<{;=])",
          "endCaptures": { "1": { "name": "entity.name.function.dslx" } },
          "patterns": [{ "include": "#comments" }]
        },
        {
          "begin": "(?<![A-Za-z0-9_!'])(?:struct|enum|proc|type|trait)(?![A-Za-z0-9_!'])",
          "beginCaptures": { "0": { "name": "storage.type.dslx" } },
          "end": "([A-Za-z_][A-Za-z0-9_!']*)|(?=[(<{;=])",
          "endCaptures": { "1": { "name": "entity.name.type.dslx" } },
          "patterns": [{ "include": "#comments" }]
        },
        {
          "begin": "(?<![A-Za-z0-9_!'])const(?![A-Za-z0-9_!'])",
          "beginCaptures": { "0": { "name": "storage.type.dslx" } },
          "end": "([A-Za-z_][A-Za-z0-9_!']*)|(?=[(<{;=])",
          "endCaptures": { "1": { "name": "variable.other.constant.dslx" } },
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "constant.language.boolean.dslx", "match": "(?<![A-Za-z0-9_!'])(?:true|false)(?![A-Za-z0-9_!'])" },
        { "name": "keyword.control.import.dslx", "match": "(?<![A-Za-z0-9_!'])(?:import|use)(?![A-Za-z0-9_!'])" },
        { "name": "keyword.control.dslx", "match": "(?<![A-Za-z0-9_!'])(?:if|else|for|match)(?![A-Za-z0-9_!'])" },
        { "name": "keyword.control.dslx", "match": "(?<![A-Za-z0-9_!'])(?:config|next)(?![A-Za-z0-9_!'])(?=\\s*\\()|(?<![A-Za-z0-9_!'])init(?![A-Za-z0-9_!'])(?=\\s*\\{)|(?<![A-Za-z0-9_!'])spawn(?![A-Za-z0-9_!'])(?=\\s+[A-Za-z_])" },
        { "name": "storage.modifier.dslx", "match": "(?<![A-Za-z0-9_!'])(?:pub|mut|in|out)(?![A-Za-z0-9_!'])" },
        { "name": "storage.type.dslx", "match": "(?<![A-Za-z0-9_!'])(?:let|impl)(?![A-Za-z0-9_!'])" },
        { "name": "keyword.operator.cast.dslx", "match": "(?<![A-Za-z0-9_!'])as(?![A-Za-z0-9_!'])" },
        { "name": "variable.language.dslx", "match": "(?<![A-Za-z0-9_!'])self(?![A-Za-z0-9_!'])" }
      ]
    },
    "builtin-types": {
      "name": "support.type.builtin.dslx",
      "match": "(?<![A-Za-z0-9_!'])(?:[us](?:[1-9]|[1-5][0-9]|6[0-4])|bits|token|uN|sN|xN|bool|chan|Self)(?![A-Za-z0-9_!'])"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.dslx", "match": "(?<![A-Za-z0-9_!'])-?0x[0-9A-Fa-f_]+(?![A-Za-z0-9_!'])" },
        { "name": "constant.numeric.binary.dslx", "match": "(?<![A-Za-z0-9_!'])-?0b[01_]+(?![A-Za-z0-9_!'])" },
        { "name": "constant.numeric.decimal.dslx", "match": "(?<![A-Za-z0-9_!'])-?(?:0|[1-9][0-9]*)(?![A-Za-z0-9_!'])" }
      ]
    },
    "macros": {
      "name": "entity.name.function.macro.dslx",
      "match": "(?<![A-Za-z0-9_!'])[A-Za-z_][A-Za-z0-9_!']*!(?![A-Za-z0-9_!'])"
    },
    "namespaces": {
      "name": "entity.name.namespace.dslx",
      "match": "(?<![A-Za-z0-9_!'])[A-Za-z_][A-Za-z0-9_!']*(?=\\s*::)"
    },
    "builtin-functions": {
      "name": "support.function.builtin.dslx",
      "match": "(?<![A-Za-z0-9_!'])(?:assert_eq|assert_lt|array_rev|array_size|and_reduce|bit_slice_update|clz|ctz|cover|decode|encode|enumerate|gate|join|map|one_hot|one_hot_sel|or_reduce|priority_sel|range|recv|recv_if|recv_if_non_blocking|recv_non_blocking|rev|send|send_if|signex|smulp|trace|umulp|update|xor_reduce|zip)(?![A-Za-z0-9_!'])(?=\\s*(?:<[^<>;\\n]*>\\s*)?\\()"
    },
    "functions": {
      "name": "entity.name.function.dslx",
      "match": "(?<![A-Za-z0-9_!'])[A-Za-z_][A-Za-z0-9_!']*(?=\\s*(?:<[^<>;\\n]*>\\s*)?\\()"
    },
    "labels": {
      "name": "entity.name.label.dslx",
      "match": "'[A-Za-z_][A-Za-z0-9_!']*(?=\\s*:)"
    },
    "identifiers": {
      "name": "variable.other.dslx",
      "match": "(?<![A-Za-z0-9_!'])[A-Za-z_][A-Za-z0-9_!']*"
    },
    "operators": {
      "name": "keyword.operator.dslx",
      "match": "\\.\\.\\.|\\.\\.=|\\.\\.|\\+\\+|\\+:|<<|>>|->|=>|==|!=|<=|>=|&&|\\|\\||[+*/%=&|^!<>-]"
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.namespace.dslx", "match": "::" },
        { "name": "punctuation.brackets.dslx", "match": "[{}()\\[\\]]" },
        { "name": "punctuation.separator.dslx", "match": "[,:;.]" },
        { "name": "punctuation.definition.label.dslx", "match": "'" }
      ]
    }
  }
}
